	img.fill(Color(0, 0, 0, 0))
	var c := (sz - 1) / 2.0
	for y in range(sz):
		for x in range(sz):
			var dd := Vector2(x - c, y - c).length()
			if dd < 6.0:
				var a := clampf(1.0 - dd / 6.0, 0.0, 1.0)
				img.set_pixel(x, y, Color(0.70, 0.66, 0.58, a))
	_dust_tex = ImageTexture.create_from_image(img)
	return _dust_tex

