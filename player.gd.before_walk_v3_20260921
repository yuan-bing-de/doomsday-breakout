func _spawn_muzzle_flash(pos: Vector2, wp_size: float):
	var flash := Sprite2D.new()
	flash.name = "MuzzleFlash"
	flash.z_index = 5   # 鐩栧湪瑙掕壊涔嬩笂

	# 鐢讳竴涓槦褰㈢伀鍏夎创鍥撅紙涓績鐧介粍 鈫?澶栧湀姗欑孩 鈫?鍗佸瓧灏勭嚎锛?	var sz := 20
	var img := Image.create(sz, sz, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	var c := sz / 2
	for y in range(sz):
		for x in range(sz):
			var dx := x - c
			var dy := y - c
			var dist := sqrt(dx * dx + dy * dy)
			if dist < 2:
				img.set_pixel(x, y, Color(1, 1, 0.85, 1))         # 鐧介粍鏍稿績
			elif dist < 4:
				img.set_pixel(x, y, Color(1, 0.8, 0.2, 0.95))     # 榛勮壊
			elif dist < 6:
				img.set_pixel(x, y, Color(1, 0.45, 0.1, 0.7))     # 姗欒壊
			elif (abs(dx) <= 1 and abs(dy) < 9) or (abs(dy) <= 1 and abs(dx) < 9):
				img.set_pixel(x, y, Color(1, 0.5, 0.1, 0.35))     # 鍗佸瓧灏勭嚎

	flash.texture = ImageTexture.create_from_image(img)
	flash.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	flash.global_position = pos
	flash.rotation = aim_dir.angle()           # 鏃嬭浆瀵归綈灏勫嚮鏂瑰悜
	var sc := 0.8 + wp_size * 0.5              # 澶у彛寰勬鍣ㄧ伀鍏夋洿澶?	flash.scale = Vector2(sc, sc)
	get_parent().add_child(flash)

	# 鍔ㄧ敾锛氬揩閫熸斁澶?+ 娣″嚭锛?.08 绉掑悗鍒犻櫎
	var tw := create_tween()
	tw.tween_property(flash, "scale", Vector2(sc * 1.6, sc * 1.6), 0.03)
	tw.parallel().tween_property(flash, "modulate:a", 0.0, 0.08)
	tw.tween_callback(flash.queue_free)

func _update_aim():
	# 鑷姩鐬勫噯锛氬彧鍦ㄦ灙鍙ｆ湞鍚戯紙facing锛夐偅涓€渚ф壘鏈€杩戜抚灏?	# 鏈濆彸(facing=1)鏃跺彧鐬勫彸杈圭殑涓у案锛屾湞宸?facing=-1)鏃跺彧鐬勫乏杈圭殑涓у案
	# 鏈濆悜鏂瑰悜娌℃湁涓у案鏃讹紝淇濇寔姘村钩鏈濆墠灏勫嚮
	aim_dir = Vector2(facing, 0)
	var zombies := get_tree().get_nodes_in_group("zombies")
	var nearest = null
	var nearest_dist := INF
	for z in zombies:
		# 鏂瑰悜杩囨护锛氬彧鏈変抚灏稿湪 facing 鏂瑰悜涓婏紙韬墠锛夋墠鍙備笌鐬勫噯
		var offset_x: float = z.global_position.x - global_position.x
		if offset_x * facing <= 0:
			continue   # 涓у案鍦ㄨ韩鍚庢垨姝ｄ笂鏂癸紝璺宠繃
		var d := global_position.distance_to(z.global_position)
		if d < nearest_dist:
			nearest_dist = d
			nearest = z
	if nearest != null:
		aim_dir = (nearest.global_position - global_position).normalized()

func _update_weapon_aim():
	if weapon_sprite == null:
		return
	var angle := aim_dir.angle()
	weapon_sprite.rotation = angle
	if aim_dir.x >= 0:
		weapon_sprite.position = HAND_OFFSET_RIGHT
		weapon_sprite.scale = Vector2(weapon_base_scale.x, weapon_base_scale.y)
	else:
		weapon_sprite.position = HAND_OFFSET_LEFT
		weapon_sprite.scale = Vector2(weapon_base_scale.x, -weapon_base_scale.y)

