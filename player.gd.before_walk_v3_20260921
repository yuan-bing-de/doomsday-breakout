	d.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	# 钀借剼鐐癸細瑙掕壊涓績寰€涓嬬害涓€涓崐韬紙鑴氬簳闄勮繎锛夛紝鍦ㄦ湞鍚戝弽渚х◢绋嶅亸鍚?	d.global_position = global_position + Vector2(-facing * randf_range(0.0, 8.0), 86.0)
