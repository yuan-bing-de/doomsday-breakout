func update_hud():
	var bar_fg: ColorRect = get_tree().get_first_node_in_group("health_bar_fg")
	var label: Label = get_tree().get_first_node_in_group("health_label")
	if bar_fg != null:

	var pct := float(health) / float(max_hp)
		pct = clamp(pct, 0.0, 1.0)

		bar_fg.size.x = int(196.0 * pct)

			bar_fg.color = Color(0.15, 0.85, 0.2, 1)
		elif pct > 0.25:
			bar_fg.color = Color(0.9, 0.75, 0.1, 1)
		else:
			bar_fg.color = Color(0.9, 0.12, 0.12, 1)
	if label != null:
		label.text = "HP: %d" % health



func take_damage(amount):
	if invuln > 0 or dead:
		return
	health -= amount
	invuln = 1.0
	await get_tree().create_timer(0.12).timeout
	sprite.modulate = Color(1, 1, 1)
	if health <= 0:
		_show_game_over()



func _show_game_over():
	dead = true
	var go_panel: Control = get_tree().get_first_node_in_group("game_over_panel")
	if go_panel != null:
		go_panel.visible = true
			if z.has_method("stop_moving"):
				z.stop_moving()

		while true:
			await get_tree().process_frame
			if Input.is_key_pressed(KEY_R):
				get_tree().reload_current_scene()
				return
	else:

		await get_tree().create_timer(0.6).timeout
		get_tree().reload_current_scene()
